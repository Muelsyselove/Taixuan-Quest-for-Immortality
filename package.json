{
  "name": "xiuxian-game",
  "version": "1.0.0",
  "description": "太玄问道 · AI 驱动的修仙文字游戏 (Electron + WebGL + SVG)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "selfcheck": "node selfcheck.js",
    "pack": "electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "com.taixuan.wendao",
    "productName": "太玄问道",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "太玄问道",
      "uninstallDisplayName": "太玄问道 ${version}",
      "artifactName": "太玄问道-Setup-${version}.exe",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "publish": null
    },
    "compression": "maximum",
    "asar": true
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.62.1"
  }
}
